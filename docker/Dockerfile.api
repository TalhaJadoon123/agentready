# AgentReady — API
#
# Node 22 alpine. Multi-stage so the runtime image carries no build tooling.
# The API has zero runtime npm dependencies, so the install layer is only the
# TypeScript compiler used to build the workspace.

FROM node:22-alpine AS build
WORKDIR /app

# Dependency manifests first, so a source-only change reuses this layer.
COPY package.json package-lock.json* bun.lockb* tsconfig.base.json tsconfig.build.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/schema/package.json packages/schema/
COPY packages/mcp/package.json packages/mcp/
COPY packages/registry/package.json packages/registry/
COPY packages/verify/package.json packages/verify/
COPY packages/api/package.json packages/api/
COPY packages/cli/package.json packages/cli/

# The build needs only the compiler; the runtime needs no node_modules at all.
RUN npm install --no-audit --no-fund --ignore-scripts typescript@5.7.2 @types/node@22.10.2

COPY . .
RUN npx tsc -b tsconfig.build.json

# ---------------------------------------------------------------------------

FROM node:22-alpine AS runtime
WORKDIR /app

# Non-root: this container serves an unauthenticated-ish public API.
RUN addgroup -S agentready && adduser -S agentready -G agentready

COPY --from=build /app/packages/*/dist ./packages/
COPY --from=build /app/package.json ./

ENV NODE_ENV=production \
    PORT=8787 \
    AGENTREADY_DB_PATH=/app/data/agentready.json \
    LOG_LEVEL=info

RUN mkdir -p /app/data && chown -R agentready:agentready /app
USER agentready

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "packages/api/dist/server.js"]