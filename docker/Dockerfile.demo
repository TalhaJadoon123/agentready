# AgentReady — demo e-commerce site
#
# The reference implementation: schema.org everywhere, /llms.txt, a live MCP
# server, OpenAPI, OAuth discovery and documented rate limits.
# Run this and scan it to see what a top-scoring site looks like.

FROM node:22-alpine AS runtime
WORKDIR /app

RUN addgroup -S agentready && adduser -S agentready -G agentready

COPY packages/seed/src ./seed
COPY package.json ./

ENV NODE_ENV=production \
    DEMO_PORT=8790 \
    DEMO_ORIGIN=http://localhost:8790

RUN chown -R agentready:agentready /app
USER agentready

EXPOSE 8790

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8790/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "seed/demo-site.mjs"]