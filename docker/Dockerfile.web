# AgentReady — web
#
# Serves the marketing site, the dashboard and /llms.txt.
# Point API_BASE at the API service so the dashboard has live data.

FROM node:22-alpine AS runtime
WORKDIR /app

RUN addgroup -S agentready && adduser -S agentready -G agentready

# The web server is plain ESM with zero dependencies — nothing to install.
COPY packages/web ./web
COPY package.json ./

ENV NODE_ENV=production \
    PORT=3000 \
    API_BASE=http://api:8787 \
    SITE_URL=http://localhost:3000

RUN chown -R agentready:agentready /app
USER agentready

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "web/server.mjs"]