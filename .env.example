# ============================================================
# AgentReady — environment configuration
# Copy to .env and fill in. Everything here has a FREE tier.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8787
LOG_LEVEL=info

# ---------- Security gates ----------
# The scanner fetches caller-supplied URLs. With this off (the default) it
# refuses private, loopback, link-local and cloud-metadata targets, which stops
# a public /scan endpoint being used as an SSRF proxy. Turn it on ONLY for
# self-hosted use or when scanning the bundled demo site on localhost.
AGENTREADY_ALLOW_PRIVATE_FETCH=false

# Allow unauthenticated API calls, resolved to a free-plan dev user.
# Off by default so a misconfigured deployment is not wide open.
AGENTREADY_DEV_AUTH=false

# Signs API bearer tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# ---------- Database (Supabase free tier: 500MB / 50k rows) ----------
# Option A: full Supabase REST (free)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Option B: direct Postgres connection string (free)
#   Supabase -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:password@db:5432/agentready
# Auto-migrate on boot when true
AUTO_MIGRATE=true

# ---------- Auth.js (NextAuth v5) — GitHub/Google OAuth are free ----------
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# ---------- LLM: Groq (free tier) — agent simulation & query analysis ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ---------- Email (Resend free: 3k/mo) ----------
EMAIL_PROVIDER=resend
EMAIL_FROM=AgentReady <reports@agentready.dev>
ALERT_EMAIL=

# ---------- MCP hosting ----------
# Cloudflare Workers free: 100k requests/day
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=agentready
# Smithery free: 25k RPC/mo
SMITHERY_API_KEY=
SMITHERY_PROFILE=agentready

# ---------- Registries ----------
# Official MCP Registry (free, MIT) — publish via GitHub PR or API
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_GITHUB_TOKEN=
# Smithery
SMITHERY_REGISTRY_URL=https://smithery.ai
# mcp.so
MCP_SO_URL=https://mcp.so

# ---------- Payments: Polar (open source) ----------
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
# Lemon Squeezy (Pakistan-friendly alternative)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
BILLING_PROVIDER=polar

# ---------- Monitoring: UptimeFlare (free) ----------
UPTIMEFLARE_API_KEY=
UPTIMEFLARE_SITE_ID=
# Fallback: plain cron + email alerts
MONITOR_INTERVAL_CRON=*/30 * * * *

# ---------- Limits / pricing tiers ----------
FREE_SCANS_PER_MONTH=1
STARTER_SCANS_PER_MONTH=50
BUSINESS_SCANS_PER_MONTH=1000
STARTER_PRICE_ID=
BUSINESS_PRICE_ID=
STARTER_PRICE_CENTS=4900
BUSINESS_PRICE_CENTS=14900

# ---------- Website / docs ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentReady
NEXT_PUBLIC_SUPPORT_EMAIL=hello@agentready.dev
