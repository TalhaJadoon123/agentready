{
  "name": "@agentready/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": { ".": { "types": "./dist/server.d.ts", "default": "./dist/server.js" } },
